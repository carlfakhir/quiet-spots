    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Spots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Spots"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location shows whether you were actually at a spot when you measured it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación muestra si realmente estabas en el lugar cuando lo mediste."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Spots uses the microphone to measure how loud a study spot is. No audio is recorded or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Spots usa el micrófono para medir qué tan ruidoso es un lugar de estudio. No se graba ni se guarda audio."
          }
        }
      }
    }
  },
  "version": "1.0"
}